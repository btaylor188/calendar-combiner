{
  "name": "calendar-combiner",
  "productName": "Calendar Combiner",
  "version": "0.1.0",
  "description": "All your Outlook calendars in one view",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux dir",
    "test": "node --test test/*.test.js"
  },
  "build": {
    "appId": "io.github.btaylor188.CalendarCombiner",
    "files": [
      "src/**",
      "node_modules/fullcalendar/index.global.min.js",
      "node_modules/@fontsource-variable/atkinson-hyperlegible-next/**"
    ],
    "linux": {
      "executableName": "calendar-combiner"
    }
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "fullcalendar": "6.1.15"
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "26.15.3"
  }
}
